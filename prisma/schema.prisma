generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(255)

  users       User[]
  permissions Permission[] @relation("RolePermissions")

  @@map("Roles")
}

model Permission {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(255)

  roles Role[] @relation("RolePermissions")

  @@map("Permissions")
}

model User {
  id           Int    @id @default(autoincrement())
  username     String @unique @db.VarChar(255)
  passwordHash String @db.Char(64)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  refreshToken UserRefreshToken?

  @@map("Users")
}

model UserRefreshToken {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  tokenHash  String   @db.Char(64)
  expiresAt  DateTime @db.DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("UserRefreshTokens")
}

model Group {
  id   Int     @id @default(autoincrement())
  name String? @db.VarChar(255)

  assets Asset[]

  @@map("Groups")
}

model Tag {
  id   Int     @id @default(autoincrement())
  name String? @db.VarChar(255)

  assets Asset[]

  @@map("Tags")
}

model Asset {
  id       Int     @id @default(autoincrement())
  name     String? @db.VarChar(255)
  notes    String? @db.Text
  position Int?

  groupId   Int?
  storageId Int?

  group Group? @relation(fields: [groupId], references: [id])

  /// Storage containing this asset
  storage Storage? @relation("StorageContents", fields: [storageId], references: [id])

  tags  Tag[]
  paths AssetPath[]
  jsons AssetJson[]

  /// Asset subtype relations
  storageType Storage? @relation("StorageAsset")
  server      Server?
  ups         UninterruptiblePowerSupply?
  pdu         PowerDistributionUnit?

  @@map("Assets")
}

model Storage {
  id Int @id

  /// This storage is itself an Asset
  asset Asset @relation("StorageAsset", fields: [id], references: [id], onDelete: Cascade)

  /// Assets stored inside this storage
  assets Asset[] @relation("StorageContents")

  @@map("Storages")
}

model Server {
  id    Int     @id
  model String? @db.VarChar(255)

  asset Asset @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("Servers")
}

model UninterruptiblePowerSupply {
  id       Int    @id
  capacity Float?

  asset Asset @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("UninterruptiblePowerSupplies")
}

model PowerDistributionUnit {
  id          Int @id
  outletCount Int?

  asset Asset @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("PowerDistributionUnits")
}

model AssetPath {
  id   Int     @id @default(autoincrement())
  path String  @db.Text
  name String? @db.VarChar(255)

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("AssetPaths")
}

model AssetJson {
  id         Int      @id @default(autoincrement())
  rawJson    String   @db.LongText
  uploadDate DateTime @default(now()) @db.DateTime

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("AssetJson")
}

model Template {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(255)

  paths TemplatePath[]

  @@map("Templates")
}

model TemplatePath {
  id   Int     @id @default(autoincrement())
  path String  @db.Text
  name String? @db.VarChar(255)

  templateId Int
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("TemplatePaths")
}