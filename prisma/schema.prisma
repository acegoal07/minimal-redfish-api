generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Rack {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(255)
  size     Int?
  notes    String? @db.VarChar(255)

  assets Asset[]

  @@map("Rack")
}

model Asset {
  id       Int     @id @default(autoincrement())
  rackId   Int
  name     String  @unique @db.VarChar(255)
  size     Int?
  position Int?

  rack        Rack          @relation(fields: [rackId], references: [id], onDelete: Cascade)
  paths       AssetPath[]
  json        AssetJson[]

  @@index([rackId])
  @@map("Asset")
}

model AssetPath {
  id      Int     @id @default(autoincrement())
  path    String  @db.Text
  name    String? @db.VarChar(255)
  assetId Int

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("AssetPath")
}

model AssetJson {
  id         Int       @id @default(autoincrement())
  rawJson    String    @db.LongText
  uploadDate DateTime  @default(now())
  filename   String?   @db.VarChar(255)
  assetId    Int

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("AssetJson")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(255)

  permissions Permission[]
  users       User[]

  @@map("Role")
}

model Permission {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(255)

  roles Role[]

  @@map("Permission")
}

model User {
  id           Int     @id @default(autoincrement())
  username     String  @unique @db.VarChar(255)
  passwordHash String  @db.Char(64)
  roleId       Int

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([roleId])
  @@map("Users")
}

model Template {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(255)

  templatePaths TemplatePath[]

  @@map("Template")
}

model TemplatePath {
  id         Int     @id @default(autoincrement())
  path       String  @db.Text
  name       String? @db.VarChar(255)
  templateId Int

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("TemplatePath")
}